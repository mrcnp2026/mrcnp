# 열쇠(키)를 적어두는 파일의 견본입니다.
# 이 파일을 복사해서 같은 폴더에 ".env.local" 이라는 이름으로 저장한 뒤, = 뒤에 값을 붙여넣으세요.
# .env.local은 git에 올라가지 않습니다. 채팅창에 키를 붙여넣지 마세요.
#
# 값은 전부 Supabase 대시보드 → 프로젝트 "출퇴근관리" 에서 찾습니다.

# ① 프로젝트 주소 — Project Settings → Data API → Project URL
#    (https://niipfcxsnaroduzjlyvc.supabase.co 형태)
NEXT_PUBLIC_SUPABASE_URL=

# ② 공개 키 — Project Settings → API Keys → Publishable key (sb_publishable_ 로 시작)
#    브라우저에 나가도 되는 키입니다. 권한 잠금 때문에 읽기만 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ③ 서버 전용 비밀 키 — Project Settings → API Keys → Secret keys (sb_secret_ 로 시작)
#    ⚠️ 서버에서만 씁니다. 브라우저·채팅·메신저로 절대 보내지 마세요.
#    노출되면 같은 화면에서 새 키를 만들고 옛 키를 지웁니다.
SUPABASE_SERVICE_ROLE_KEY=

# ④ 데이터베이스 직접 연결 주소 — 권한 잠금 자동 검사(npm run verify:rls)에만 씁니다. 앱은 쓰지 않습니다.
#    상단 "Connect" 버튼 → Connection String → "Session pooler" 주소를 복사하고
#    [YOUR-PASSWORD] 자리에 프로젝트를 만들 때 정한 데이터베이스 비밀번호를 넣으세요.
SUPABASE_DB_URL=

# ⑤ 사무실 인터넷 주소 — 게이트 5에서 넣습니다. 지금은 비워 두세요.
#    여러 개면 쉼표로: 203.0.113.10/32,2001:db8:1234:5678::/64
OFFICE_CIDRS=

# ⑥ 공지 번역 초안용 — ②-5(게이트 15)에서 넣습니다. 지금은 비워 두세요.
GEMINI_API_KEY=
GEMINI_TRANSLATE_MODEL=
