# 열쇠(키)를 적어두는 파일의 견본입니다.
# 이 파일을 복사해서 같은 폴더에 ".env.local" 이라는 이름으로 저장한 뒤, = 뒤에 값을 붙여넣으세요.
# .env.local은 git에 올라가지 않습니다. 채팅창에 키를 붙여넣지 마세요.
#
# 값은 전부 Supabase 대시보드 → 프로젝트 "출퇴근관리" 에서 찾습니다.

# ① 프로젝트 주소 — Project Settings → Data API → Project URL
#    (https://niipfcxsnaroduzjlyvc.supabase.co 형태)
NEXT_PUBLIC_SUPABASE_URL=

# ② 공개 키 — Project Settings → API Keys → Publishable key (sb_publishable_ 로 시작)
#    브라우저에 나가도 되는 키입니다. 권한 잠금 때문에 읽기만 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ③ 서버 전용 비밀 키 — Project Settings → API Keys → Secret keys (sb_secret_ 로 시작)
#    ⚠️ 서버에서만 씁니다. 브라우저·채팅·메신저로 절대 보내지 마세요.
#    노출되면 같은 화면에서 새 키를 만들고 옛 키를 지웁니다.
SUPABASE_SERVICE_ROLE_KEY=

# ④ 데이터베이스 직접 연결 주소 — 권한 잠금 자동 검사(npm run verify:rls)에만 씁니다. 앱은 쓰지 않습니다.
#    상단 "Connect" 버튼 → "Session pooler" 주소를 복사하고 (pooler.supabase.com 이 들어간 주소)
#    ⚠️ db.….supabase.co 로 시작하는 "Direct connection" 주소는 안 됩니다 (IPv6 전용 — 마스터 8-2)
#    [YOUR-PASSWORD] 자리에 프로젝트를 만들 때 정한 데이터베이스 비밀번호를 넣으세요.
SUPABASE_DB_URL=

# ⑦ 앱 주소 — 내 PC에서는 비워 두세요 (자동으로 http://localhost:4123).
#    배포(게이트 9) 때 실제 주소를 넣습니다. 예: https://attendance.example.com
#    ⚠️ 출퇴근 기기 등록이 이 주소에 묶입니다. 직원이 기기를 등록한 뒤에 바꾸면 전원이 출퇴근 기기를 다시 등록해야 합니다. (비밀번호 로그인은 그대로 됩니다.)
APP_ORIGIN=

# ⑤ 사무실 인터넷 주소 — 게이트 5에서 넣습니다. 지금은 비워 두세요.
#    여러 개면 쉼표로: 203.0.113.10/32,2001:db8:1234:5678::/64
OFFICE_CIDRS=

# ⑥ 공지 번역 초안용 — ②-5(게이트 15)에서 넣습니다. 지금은 비워 두세요.
GEMINI_API_KEY=
GEMINI_TRANSLATE_MODEL=
#    과부하(503) 때 차례로 쓸 대체 모델 — 쉼표로. 예: gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TRANSLATE_FALLBACK_MODELS=

# 공식자료 정기 수집(매월 1일 · 16일 09:00 한국시간)을 부르는 비밀값. Vercel 환경변수에 넣으면 Vercel이 정기 실행 때 함께 보낸다. 비워 두면 정기 수집은 돌지 않는다(「지금 업데이트」는 된다).
CRON_SECRET=

# ⑧ 네이버 지도 (2026-10-25) — 출퇴근 장소 지도와 주소 → 좌표 변환을 네이버로. 비워 두면 오픈스트리트맵(지도) · 다음 주소 검색을 씁니다.
#    네이버 클라우드 플랫폼 콘솔 > AI·NAVER API > Application 에서 앱을 만들고 「Maps」의 Web Dynamic Map · Geocoding 을 체크합니다.
#    「Web 서비스 URL」에 https://mrcnp-saas.vercel.app (그리고 내 PC 테스트용 http://localhost:4123)을 등록하세요 — 안 하면 지도가 뜨지 않습니다.
#    · NEXT_PUBLIC_NAVER_MAP_CLIENT_ID : 지도 화면용. 앱의 「Client ID」(새 콘솔의 「API Key ID」). 브라우저에 나가도 되는 값입니다.
#    · NAVER_GEOCODE_ID / NAVER_GEOCODE_SECRET : 주소 → 좌표용. 같은 앱의 Client ID / Client Secret. ⚠️ Secret은 서버 전용 — 채팅·메신저로 보내지 마세요.
#    ⚠️ NEXT_PUBLIC_ 값은 배포할 때 화면 코드에 박힙니다 — Vercel 환경변수에 넣은 뒤 다시 배포해야 반영됩니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_GEOCODE_ID=
NAVER_GEOCODE_SECRET=
